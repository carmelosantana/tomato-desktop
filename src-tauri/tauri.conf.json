{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomato",
  "version": "0.1.0",
  "identifier": "com.carmelosantana.tomato",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tomato",
        "width": 800,
        "height": 600,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "A gentle presence-aware focus companion for your tray.",
    "longDescription": "Tomato is a gentle, presence-aware focus companion that lives in your system tray. It notices when you've been focused for a while and quietly nudges you to step away with a soft desktop notification — no forced breaks, no blocking, no timers to babysit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  }
}
