{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "stats-window",
  "description": "Capability for the stats window: it reads the event log (fs) to compute the adherence view. No writes.",
  "windows": ["stats"],
  "permissions": [
    "core:default",
    "core:event:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$DATA/tomato/events.jsonl" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$DATA/tomato/events.jsonl" }]
    }
  ]
}
