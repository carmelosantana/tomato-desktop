{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Capability for the settings window: it reads/writes config.json (fs), toggles autostart-on-login, emits the settings-saved signal, and closes itself.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "fs:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$CONFIG/tomato" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$CONFIG/tomato/config.json" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$CONFIG/tomato/config.json" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$CONFIG/tomato/config.json" }]
    }
  ]
}
